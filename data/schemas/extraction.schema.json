{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extraction.schema.json",
  "title": "Chapters of the 'From bone to genome' page",
  "type": "object",
  "required": ["version", "chapters"],
  "properties": {
    "version": {"type": "integer"},
    "notes": {"type": "string"},
    "chapters": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "text", "evidence_ids", "facts"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "title": {"type": "string", "minLength": 3},
        "summary": {"type": "string", "minLength": 10},
        "text": {"type": "string", "minLength": 80},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "facts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "value", "evidence_ids"],
          "properties": {"label": {"type": "string"}, "value": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
        }},
        "caveat": {"type": "string"}
      }
    }}
  }
}
