{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "year": {"type": "integer", "minimum": -300000, "maximum": 2100},
    "timeRange": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/year"}, "end": {"$ref": "#/$defs/year"}}
    },
    "openTimeRange": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/year"}, "end": {"oneOf": [{"$ref": "#/$defs/year"}, {"type": "null"}]}}
    },
    "proportion": {
      "type": "object", "additionalProperties": false, "required": ["value", "kind"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "low": {"type": "number", "minimum": 0, "maximum": 1},
        "high": {"type": "number", "minimum": 0, "maximum": 1},
        "kind": {"enum": ["estimate_se", "ci95", "range", "approximate"]},
        "note": {"type": "string"}
      }
    }
  }
}
