{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "disagreements.schema.json",
  "type": "object", "required": ["version", "disagreements"],
  "properties": {
    "version": {"type": "integer"},
    "disagreements": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "topic", "summary", "positions", "affects", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^d-[a-z0-9-]+$"},
        "topic": {"type": "string"}, "summary": {"type": "string", "minLength": 40},
        "status": {"enum": ["open", "narrowed"]},
        "positions": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["label", "evidence_ids"], "properties": {"label": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}}},
        "affects": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    }}
  }
}
